<div class="poke5e-panel">
  <header class="poke5e-hero">
    <div class="poke5e-ball" aria-hidden="true"></div>
    <div>
      <p class="eyebrow">{{localize "POKE5E.Reference.DigitalManual"}}</p>
      <h1>Pokémon 5e</h1>
      <p>{{localize "POKE5E.Reference.Subtitle"}}</p>
    </div>
  </header>

  <div class="poke5e-reference-grid">
    {{#each links}}
      <a href="{{url}}" target="_blank" rel="noopener"><i class="{{icon}}"></i><span>{{label}}</span><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
    {{/each}}
  </div>

  {{#if isGM}}
    <footer class="poke5e-actions">
      <span>{{localize "POKE5E.Reference.FirstTime"}}</span>
      <button type="button" class="bright" data-action="open-importer"><i class="fa-solid fa-download"></i> {{localize "POKE5E.Reference.Import"}}</button>
    </footer>
  {{/if}}
</div>
