<div class="poke5e-creator-body">
  <header class="poke5e-creator-hero">
    <div><span class="eyebrow">{{localize "POKE5E.Creator.PlayerCharacter"}}</span><h1>{{localize "POKE5E.Creator.NewTrainer"}}</h1><p>{{localize "POKE5E.Creator.HumanTrainerLevelOne"}}</p></div>
    <i class="fa-solid fa-user-group"></i>
  </header>

  <nav class="poke5e-creator-steps" aria-label="{{localize "POKE5E.Creator.Progress"}}">
    <span class="{{#if step1}}active{{/if}}"><b>1</b> {{localize "POKE5E.Creator.IdentityOrigin"}}</span>
    <span class="{{#if step2}}active{{/if}}"><b>2</b> {{localize "POKE5E.Creator.ClassSpecialization"}}</span>
    <span class="{{#if step3}}active{{/if}}"><b>3</b> {{localize "POKE5E.Creator.StarterPokemon"}}</span>
    <span class="{{#if step4}}active{{/if}}"><b>4</b> {{localize "POKE5E.Common.Summary"}}</span>
  </nav>

  <main class="poke5e-creator-stage">
    {{#if step1}}
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-id-card"></i> {{localize "POKE5E.Creator.Identity"}}</h2></div>
        <div class="poke5e-creator-fields three">
          <label><span>{{localize "POKE5E.Common.Name"}}</span><input name="name" type="text" value="{{selection.name}}" required></label>
          <label><span>{{localize "POKE5E.Common.Gender"}}</span><input name="gender" type="text" value="{{selection.gender}}" placeholder="{{localize "POKE5E.Common.Optional"}}"></label>
          <label><span>{{localize "POKE5E.Common.Age"}}</span><input name="age" type="number" min="1" value="{{selection.age}}" placeholder="{{localize "POKE5E.Common.Optional"}}"></label>
        </div>
        <div class="poke5e-callout"><i class="fa-solid fa-person"></i><div><strong>{{localize "POKE5E.Creator.SpeciesHuman"}}</strong><br>{{localize "POKE5E.Creator.HumanOnlyHint"}}</div></div>
      </section>
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-dice-d20"></i> {{localize "POKE5E.Creator.BaseAbilities"}}</h2>{{#if baseAbilityPointBuy}}<span>{{localize "POKE5E.Creator.PointsSpent" spent=pointBuySpent}}</span>{{/if}}</div>
        <label class="poke5e-wide-field"><span>{{localize "POKE5E.Creator.GenerationMethod"}}</span><select name="baseAbilityMethod">{{#each baseAbilityMethods}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <p>{{localize "POKE5E.Creator.BaseAbilitiesHint"}}</p>
        <div class="poke5e-base-abilities">
          {{#each baseAbilityFields}}
            <label><span>{{label}}</span>
              {{#if ../baseAbilityStandard}}
                <select name="{{inputName}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{else}}
                <input type="number" name="{{inputName}}" value="{{value}}" min="{{#if ../baseAbilityPointBuy}}8{{else}}3{{/if}}" max="{{#if ../baseAbilityPointBuy}}15{{else}}18{{/if}}">
              {{/if}}
            </label>
          {{/each}}
        </div>
        {{#if baseAbilityPointBuy}}<div class="poke5e-bonus-banner {{#if pointBuyRemaining}}warning{{/if}}">{{localize "POKE5E.Creator.PointsRemaining" remaining=pointBuyRemaining}}</div>{{/if}}
      </section>
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-earth-americas"></i> {{localize "POKE5E.Creator.RegionalOrigin"}}</h2></div>
        <label class="poke5e-wide-field"><span>{{localize "POKE5E.Creator.HomeRegion"}}</span><select name="origin"><option value="">{{localize "POKE5E.Creator.ChooseRegion"}}</option>{{#each origins}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#if origin}}
          <article class="poke5e-origin-card">
            <div><strong>{{origin.name}}</strong><span>{{localize "POKE5E.Creator.Proficiency"}}: {{lookup skills origin.skill}}</span><span>{{localize "POKE5E.Creator.Language"}}: {{origin.language}}</span></div>
            <div><strong>{{origin.featName}}</strong><p>{{origin.featEffect}}</p></div>
          </article>
          {{#if originFixedAbilities}}<div class="poke5e-bonus-banner"><strong>{{localize "POKE5E.Creator.Abilities"}}:</strong> {{originFixedAbilities}}</div>{{/if}}
          {{#if originAbilityOptions}}<label class="poke5e-wide-field"><span>{{localize "POKE5E.Creator.AbilityBonus"}}</span><select name="originAbilityOption">{{#each originAbilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          {{#if originAnyTwo}}<div class="poke5e-creator-fields two"><label><span>+2 a</span><select name="originAbilityPrimary">{{#each abilityOptionsPrimary}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>+1 a</span><select name="originAbilitySecondary">{{#each abilityOptionsSecondary}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>{{/if}}
          {{#if isHoenn}}<label class="poke5e-wide-field"><span>{{localize "POKE5E.Creator.HoennEnvironment"}}</span><select name="environment"><option value="">{{localize "POKE5E.Common.Choose"}}</option>{{#each environmentOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          {{#if isKanto}}
            <label class="poke5e-wide-field">
              <span>{{localize "POKE5E.Creator.ChosenFeat"}}</span>
              <select name="chosenFeat">
                <option value="">{{localize "POKE5E.Common.Choose"}}</option>
                {{#each chosenFeatOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
              {{#unless chosenFeatOptions.length}}<small>{{localize "POKE5E.Creator.ChosenFeatEmpty"}}</small>{{/unless}}
            </label>
          {{/if}}
        {{/if}}
      </section>
    {{/if}}

    {{#if step2}}
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-medal"></i> {{localize "POKE5E.Creator.LevelOneSpecialization"}}</h2></div>
        <p>{{localize "POKE5E.Creator.SpecializationHint"}}</p>
        <div class="poke5e-specialization-grid">{{#each specializations}}<label class="{{#if selected}}selected{{/if}}"><input type="radio" name="specialization" value="{{value}}" {{#if selected}}checked{{/if}}><strong>{{label}}</strong><span>{{effect}}</span></label>{{/each}}</div>
      </section>
      {{#if hasSpecialization}}
        <section>
          <div class="poke5e-section-title"><h2><i class="fa-solid fa-list-check"></i> {{localize "POKE5E.Creator.TrainerProficiencies"}}</h2><span>{{localize "POKE5E.Creator.ChosenCount" count=selectedClassSkillCount}}</span></div>
          <div class="poke5e-granted-skills">
            <strong>{{localize "POKE5E.Creator.AlreadyGranted"}}</strong>
            {{#each grantedSkills}}<span><small>{{source}}</small>{{label}}</span>{{/each}}
            {{#if specializationAbilityBonus}}<p>{{specializationAbilityBonus}}</p>{{/if}}
          </div>
          <p>{{localize "POKE5E.Creator.AdditionalSkillsHint"}}</p>
          <div class="poke5e-choice-grid">{{#each classSkillOptions}}<label><input type="checkbox" name="classSkills" value="{{value}}" {{#if selected}}checked{{/if}}> {{label}}</label>{{/each}}</div>
          <div class="poke5e-selected-skills"><strong>{{localize "POKE5E.Creator.Selected"}}:</strong>{{#each selectedClassSkills}}<span>{{this}}</span>{{else}}<em>{{localize "POKE5E.Common.NoneYet"}}</em>{{/each}}</div>
          {{#if isUnova}}<div class="poke5e-callout"><i class="fa-solid fa-star"></i><div><strong>{{localize "POKE5E.Creator.ManyTalents"}}</strong><br>{{localize "POKE5E.Creator.ManyTalentsHint"}}</div></div><div class="poke5e-choice-grid">{{#each extraSkillOptions}}<label><input type="checkbox" name="extraSkills" value="{{value}}" {{#if selected}}checked{{/if}}> {{label}}</label>{{/each}}</div>{{/if}}
        </section>
      {{else}}
        <div class="poke5e-callout warning"><i class="fa-solid fa-arrow-up"></i><div>{{localize "POKE5E.Creator.SelectSpecialization"}}</div></div>
      {{/if}}
    {{/if}}

    {{#if step3}}
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-circle-dot"></i> {{localize "POKE5E.Creator.FirstPokemon"}}</h2><span>{{localize "POKE5E.Creator.StarterRequirements"}}</span></div>
        <div class="poke5e-creator-fields">
          <label><span>{{localize "POKE5E.Common.Species"}}</span><select name="starter"><option value="">{{localize "POKE5E.Creator.ChooseSpecies"}}</option>{{#each starters}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
        <div class="poke5e-callout"><i class="fa-solid fa-dice"></i><div>{{localize "POKE5E.Creator.RandomStarterTraits"}}</div></div>
        {{#if starter}}<article class="poke5e-starter-preview"><img src="{{starter.img}}" alt="{{starter.name}}"><div><strong>{{starter.name}}</strong><span>SR {{starter.sr}} · Nivel mínimo {{starter.minLevel}}</span><p>{{starter.description}}</p></div></article>{{/if}}
      </section>
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-briefcase"></i> {{localize "POKE5E.Creator.AutomaticStartingKit"}}</h2></div>
        <div class="poke5e-starting-kit"><span>{{localize "POKE5E.Creator.FivePokeBalls"}}</span><span>{{localize "POKE5E.Creator.OnePotion"}}</span><span>{{localize "POKE5E.Creator.License"}}</span><span>{{localize "POKE5E.Creator.Pokedex"}}</span><span>1000 + 100 × 4d4 ₽</span></div>
      </section>
    {{/if}}

    {{#if step4}}
      <section>
        <div class="poke5e-section-title"><h2><i class="fa-solid fa-clipboard-check"></i> {{localize "POKE5E.Creator.ReviewTrainer"}}</h2></div>
        {{#if resolutionError}}<div class="poke5e-callout warning">{{resolutionError}}</div>{{else}}
          <div class="poke5e-creator-summary">
            <article><span>{{localize "POKE5E.Creator.Identity"}}</span><strong>{{selection.name}}</strong><p>{{localize "POKE5E.Creator.HumanFrom" origin=resolved.origin.name}}</p></article>
            <article><span>{{localize "POKE5E.Creator.Abilities"}}</span><strong>{{abilitySummary}}</strong><p>{{localize "POKE5E.Creator.StartingHp" hp=resolved.hp}}</p></article>
            <article><span>{{localize "POKE5E.Creator.Proficiencies"}}</span><strong>{{skillSummary}}</strong><p>{{localize "POKE5E.Creator.SavesCharisma"}}{{#if hasConstitutionSave}} {{localize "POKE5E.Creator.AndConstitution"}}{{/if}}</p></article>
            <article><span>{{localize "POKE5E.Creator.Features"}}</span><strong>{{resolved.origin.featName}}</strong><p>{{resolved.specialization.name}} · {{localize "POKE5E.Common.Type"}} {{resolved.specialization.type}}</p></article>
            <article><span>{{localize "POKE5E.Creator.StarterPokemon"}}</span><strong>{{starter.name}}</strong><p>{{selectedNatureLabel}} · {{selectedAbilityLabel}}</p></article>
            <article><span>{{localize "POKE5E.Creator.Class"}}</span><strong>{{localize "POKE5E.Creator.TrainerLevelOne"}}</strong><p>{{localize "POKE5E.Creator.ClassSummary"}}</p></article>
          </div>
          <div class="poke5e-callout success"><i class="fa-solid fa-wand-magic-sparkles"></i><div>{{localize "POKE5E.Creator.CreationResultHint"}}</div></div>
        {{/if}}
      </section>
    {{/if}}
  </main>

  <footer class="poke5e-creator-actions">
    <button type="button" data-action="back" {{#unless canBack}}disabled{{/unless}}><i class="fa-solid fa-arrow-left"></i> {{localize "POKE5E.Common.Back"}}</button>
    {{#if isLast}}<button type="button" class="bright" data-action="finish" {{#if saving}}disabled{{/if}}><i class="fa-solid fa-check"></i> {{#if saving}}{{localize "POKE5E.Common.Creating"}}{{else}}{{localize "POKE5E.Creator.CreateTrainer"}}{{/if}}</button>{{else}}<button type="button" class="bright" data-action="next">{{localize "POKE5E.Common.Next"}} <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
  </footer>
</div>
