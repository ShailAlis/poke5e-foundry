<div class="poke5e-team-app">
  <header class="poke5e-hero compact">
    <div class="poke5e-ball" aria-hidden="true"></div>
    <div>
      <p class="eyebrow">{{actor.name}}</p>
      <h1>{{localize "POKE5E.Team.Title"}}</h1>
      <p>{{localize "POKE5E.Team.Summary" active=teamCount limit=maxTeamSize total=totalCount}}</p>
    </div>
    {{#if canEdit}}<div class="poke5e-team-header-actions"><button type="button" class="bright" data-action="capture-target"><i class="fa-solid fa-circle-dot"></i> {{localize "POKE5E.Team.CaptureTarget"}}</button><button type="button" data-action="browse-species"><i class="fa-solid fa-plus"></i> {{localize "POKE5E.Team.AddFromPokedex"}}</button></div>{{/if}}
  </header>

  <section class="poke5e-currency-panel">
    <i class="fa-solid fa-coins"></i>
    <label><span>{{localize "POKE5E.Currency.Name"}}</span><input type="number" min="0" step="1" value="{{pokedollars}}" data-poke5e-pokedollars {{#unless canEdit}}disabled{{/unless}}></label>
    <strong>₽</strong>
  </section>

  <section>
    <div class="poke5e-section-title"><h2>{{localize "POKE5E.Team.Active"}}</h2><span>{{teamCount}} / {{maxTeamSize}}</span></div>
    <div class="poke5e-team-grid">
      {{#each team}}
        <article class="poke5e-team-card" data-item-id="{{id}}">
          <img src="{{img}}" alt="{{name}}">
          <div class="poke5e-team-card-body">
            <input class="poke5e-nickname" value="{{instance.nickname}}" placeholder="{{speciesName}}" data-field="nickname" {{#unless ../canEdit}}disabled{{/unless}}>
            <p>{{speciesName}} · {{localize "POKE5E.Common.Level"}} <input type="number" min="1" max="20" value="{{instance.level}}" data-field="level" {{#unless ../canEdit}}disabled{{/unless}}></p>
            <div class="poke5e-types">{{#each types}}<span class="poke5e-type type-{{this}}">{{this}}</span>{{/each}}</div>
            <label>{{localize "POKE5E.Common.HitPointsShort"}} <input type="number" min="0" max="{{instance.hp.max}}" value="{{instance.hp.value}}" data-field="hp.value" {{#unless ../canEdit}}disabled{{/unless}}> / {{instance.hp.max}}</label>
            <div class="pokemon-exp" title="{{localize "POKE5E.Common.TotalXP" xp=experience.total}}"><span style="width: {{experience.percent}}%"></span></div>
            <small>{{#if experience.maximumLevel}}{{localize "POKE5E.Common.MaximumLevel"}}{{else}}{{localize "POKE5E.Common.XPToLevel" xp=experience.remaining level=experience.nextLevel}}{{/if}}</small>
          </div>
          <div class="poke5e-card-actions">
            <button type="button" data-action="open-pokemon" title="{{localize "POKE5E.Team.OpenSheet"}}"><i class="fa-solid fa-address-card"></i></button>
            {{#if deployed}}<button type="button" data-action="recall" title="{{localize "POKE5E.Team.Recall"}}"><i class="fa-solid fa-arrow-rotate-left"></i></button>{{else}}<button type="button" data-action="deploy" title="{{localize "POKE5E.Team.Deploy"}}"><i class="fa-solid fa-location-dot"></i></button>{{/if}}
            <button type="button" data-action="toggle-team" title="{{localize "POKE5E.Team.SendReserve"}}"><i class="fa-solid fa-box-archive"></i></button>
            <button type="button" data-action="remove" title="{{localize "POKE5E.Team.RemoveTrainer"}}"><i class="fa-solid fa-trash"></i></button>
          </div>
        </article>
      {{else}}<div class="poke5e-empty">{{localize "POKE5E.Team.Empty"}}</div>{{/each}}
    </div>
  </section>

  {{#if reserve.length}}
  <section>
    <div class="poke5e-section-title"><h2>{{localize "POKE5E.Team.Reserve"}}</h2><span>{{reserve.length}}</span></div>
    <div class="poke5e-reserve-list">
      {{#each reserve}}
        <article data-item-id="{{id}}">
          <img src="{{img}}" alt="{{name}}"><strong>{{name}}</strong><span>{{speciesName}} · {{localize "POKE5E.Team.ReserveStats" level=instance.level hp=instance.hp.value max=instance.hp.max xp=experience.total}}{{#if overflow}} · {{localize "POKE5E.Team.OutsideLimit"}}{{/if}}</span>
          <button type="button" data-action="open-pokemon"><i class="fa-solid fa-address-card"></i></button>
          <button type="button" data-action="toggle-team"><i class="fa-solid fa-arrow-up"></i> {{localize "POKE5E.Team.ToTeam"}}</button>
          <button type="button" data-action="remove"><i class="fa-solid fa-trash"></i></button>
        </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if gear.length}}
  <section>
    <div class="poke5e-section-title"><h2>{{localize "POKE5E.Team.PokemonItems"}}</h2><span>{{localize "POKE5E.Team.ItemsHint"}}</span></div>
    <div class="poke5e-gear-row">{{#each gear}}<span><img src="{{img}}" alt="">{{name}} ×{{quantity}}</span>{{/each}}</div>
  </section>
  {{/if}}
</div>
