<div class="poke5e-panel">
  <header class="poke5e-hero compact">
    <div class="poke5e-ball" aria-hidden="true"></div>
    <div>
      <p class="eyebrow">Foundry VTT + D&amp;D 5e</p>
      <h1>{{localize "POKE5E.Importer.Title"}}</h1>
      <p>{{localize "POKE5E.Importer.Subtitle"}}</p>
    </div>
  </header>

  {{#unless isGM}}
    <div class="poke5e-callout warning">{{localize "POKE5E.Importer.GMOnly"}}</div>
  {{/unless}}

  <fieldset>
    <legend>{{localize "POKE5E.Importer.ContentPacks"}}</legend>
    <label class="poke5e-check"><input type="checkbox" name="species" checked> <span><strong>{{localize "POKE5E.Common.Species"}}</strong><small>{{localize "POKE5E.Importer.SpeciesHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="moves" checked> <span><strong>{{localize "POKE5E.Common.Moves"}}</strong><small>{{localize "POKE5E.Importer.MovesHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="abilities" checked> <span><strong>{{localize "POKE5E.Common.Abilities"}}</strong><small>{{localize "POKE5E.Importer.AbilitiesHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="gear" checked> <span><strong>{{localize "POKE5E.Common.Items"}}</strong><small>{{localize "POKE5E.Importer.ItemsHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="progression" checked> <span><strong>{{localize "POKE5E.Importer.TrainerClass"}}</strong><small>{{localize "POKE5E.Importer.TrainerClassHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="feats" checked> <span><strong>{{localize "POKE5E.Importer.Feats"}}</strong><small>{{localize "POKE5E.Importer.FeatsHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="conditions" checked> <span><strong>{{localize "POKE5E.Importer.Conditions"}}</strong><small>{{localize "POKE5E.Importer.ConditionsHint"}}</small></span></label>
    <label class="poke5e-check"><input type="checkbox" name="reference" checked> <span><strong>{{localize "POKE5E.Importer.RulesReference"}}</strong><small>{{localize "POKE5E.Importer.RulesReferenceHint"}}</small></span></label>
  </fieldset>

  <fieldset>
    <legend>{{localize "POKE5E.Importer.PokedexContent"}}</legend>
    <label class="poke5e-field">
      <span>{{localize "POKE5E.Importer.CommaSeparatedIds"}}</span>
      <textarea name="pokemonIds" rows="3" spellcheck="false">{{defaultPokemon}}</textarea>
      <small>{{localize "POKE5E.Importer.SelectionHint" count=(numberFormat 1151)}}</small>
    </label>
  </fieldset>

  <div class="poke5e-callout">
    {{localize "POKE5E.Importer.Language" language=language}}
  </div>

  <div class="poke5e-import-status" data-import-status aria-live="polite">
    <progress max="100" value="0"></progress>
    <span>{{localize "POKE5E.Importer.Ready"}}</span>
  </div>

  <footer class="poke5e-actions">
    <a href="{{referenceUrl}}" target="_blank" rel="noopener">{{localize "POKE5E.Common.OpenPoke5e"}}</a>
    <button type="button" class="bright" data-action="import" {{#unless isGM}}disabled{{/unless}}><i class="fa-solid fa-box-archive"></i> {{localize "POKE5E.Importer.Import"}}</button>
  </footer>
</div>
