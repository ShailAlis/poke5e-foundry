<article class="poke5e-dex">
  <header class="poke5e-dex-header">
    <div class="poke5e-dex-number">#{{data.number}}</div>
    <img src="{{img}}" alt="{{name}}">
    <div class="poke5e-dex-identity">
      <p class="eyebrow">Pokédex · Nivel {{level}}</p>
      <h1>{{name}}</h1>
      {{#if instance.nickname}}<p class="poke5e-species-name">{{species.name}}</p>{{/if}}
      <div class="poke5e-types">
        {{#each types}}<span class="poke5e-type type-{{id}}">{{label}}</span>{{/each}}
      </div>
      <div class="poke5e-pokemon-meta">
        <span title="{{gender.probability}}"><i class="fa-solid {{gender.icon}}"></i> {{gender.label}}</span>
      </div>
    </div>
    <div class="poke5e-vitals">
      <div><span>CA</span><strong>{{ac}}</strong></div>
      <label><span>PG</span><input type="number" min="0" max="{{hp.max}}" value="{{hp.value}}" data-action="change-hp" {{#unless canEdit}}disabled{{/unless}}><small>/ {{hp.max}}</small></label>
      <label><span>Nivel</span><input type="number" min="1" max="20" value="{{level}}" data-action="change-level" {{#unless canEdit}}disabled{{/unless}}></label>
    </div>
  </header>

  <section class="poke5e-stat-grid" aria-label="Características">
    {{#each abilityScores}}
      <div><span>{{key}}</span><strong>{{score}}</strong><small>{{modifier}}</small></div>
    {{/each}}
  </section>

  <section class="poke5e-speed-panel" aria-label="Velocidades de movimiento">
    <h2><i class="fa-solid fa-shoe-prints"></i> Velocidad</h2>
    <div class="poke5e-speed-list">
      {{#each speeds}}
        <div><i class="fa-solid {{icon}}"></i><span>{{label}}</span><strong>{{value}} pies</strong></div>
      {{/each}}
    </div>
  </section>

  <section class="poke5e-combat-profile" aria-label="Afinidades de daño">
    <div class="poke5e-defense-group vulnerable">
      <h2><i class="fa-solid fa-heart-crack"></i> Vulnerabilidades</h2>
      <div class="poke5e-types">{{#each defenses.vulnerabilities}}<span class="poke5e-type type-{{id}}">{{label}}</span>{{else}}<span class="poke5e-none">Ninguna</span>{{/each}}</div>
    </div>
    <div class="poke5e-defense-group resistant">
      <h2><i class="fa-solid fa-shield-halved"></i> Resistencias</h2>
      <div class="poke5e-types">{{#each defenses.resistances}}<span class="poke5e-type type-{{id}}">{{label}}</span>{{else}}<span class="poke5e-none">Ninguna</span>{{/each}}</div>
    </div>
    <div class="poke5e-defense-group immune">
      <h2><i class="fa-solid fa-shield"></i> Inmunidades</h2>
      <div class="poke5e-types">{{#each defenses.immunities}}<span class="poke5e-type type-{{id}}">{{label}}</span>{{else}}<span class="poke5e-none">Ninguna</span>{{/each}}</div>
    </div>
  </section>

  <section class="poke5e-evolution-panel" aria-label="Evoluciones">
    <h2><i class="fa-solid fa-dna"></i> Evolución</h2>
    <div class="poke5e-evolution-list">
      {{#each evolutions}}
        <article>
          <div><span>Evoluciona a</span><strong>{{toName}}</strong></div>
          <div class="poke5e-evolution-conditions">{{#each conditions}}<span>{{this}}</span>{{/each}}</div>
        </article>
      {{else}}
        <span class="poke5e-none">Esta especie no tiene una evolución posterior registrada.</span>
      {{/each}}
    </div>
  </section>

  <nav class="poke5e-sheet-actions">
    <button type="button" data-action="open-trainer-sheet"><i class="fa-solid fa-user-shield"></i> Abrir entrenador</button>
  </nav>

  <section>
    <div class="poke5e-section-title">
      <h2>Movimientos</h2>
      <span>{{moves.length}}/{{maxKnownMoves}} conocidos</span>
      {{#if canEdit}}<button type="button" data-action="toggle-move-manager"><i class="fa-solid fa-list-check"></i> {{#if moveManager.open}}Cerrar gestor{{else}}Gestionar movimientos{{/if}}</button>{{/if}}
    </div>
    {{#if moveLimitExceeded}}<div class="poke5e-callout"><i class="fa-solid fa-triangle-exclamation"></i> Esta ficha conserva más de cuatro movimientos de una versión anterior. Olvida los sobrantes antes de aprender otro.</div>{{/if}}
    {{#if canEdit}}<div class="poke5e-drop-hint"><i class="fa-solid fa-shield-halved"></i> Solo se pueden aprender movimientos compatibles y disponibles para el nivel actual.</div>{{/if}}
    {{#if moveManager.open}}
      <div class="poke5e-move-manager">
        <header>
          <label><i class="fa-solid fa-magnifying-glass"></i><input type="search" value="{{moveManager.filters.query}}" placeholder="Buscar movimiento…" data-action="search-moves"></label>
          <select data-action="filter-moves" aria-label="Filtrar movimientos">{{selectOptions moveManager.categoryOptions selected=moveManager.filters.category}}</select>
          <span>{{moveManager.total}} resultados</span>
        </header>
        {{#if moveManager.truncated}}<div class="poke5e-callout">Se muestran los primeros 120 resultados. Usa la búsqueda para acotar la lista.</div>{{/if}}
        <div class="poke5e-move-catalog">
          {{#each moveManager.entries}}
            <details class="poke5e-move-catalog-entry {{#unless compatible}}incompatible{{/unless}} {{#if future}}future{{/if}}">
              <summary>
                <span class="poke5e-type type-{{type}}">{{type}}</span>
                <div class="poke5e-move-catalog-name"><strong>{{name}}</strong><small>PP {{pp}}</small></div>
                <div class="poke5e-learning-methods">
                  {{#each methods}}<span>{{label}}</span>{{else}}<span class="warning">No compatible</span>{{/each}}
                </div>
                {{#if known}}
                  <button type="button" disabled title="Ya conocido"><i class="fa-solid fa-check"></i> Conocido</button>
                {{else}}
                  <button type="button" class="bright" data-action="learn-move" data-move-id="{{id}}" {{#unless availableNow}}disabled{{/unless}} title="{{#if future}}Disponible más adelante{{else}}{{#unless compatible}}Esta especie no puede aprenderlo{{/unless}}{{/if}}"><i class="fa-solid fa-plus"></i> Aprender</button>
                {{/if}}
                <i class="fa-solid fa-chevron-down poke5e-catalog-expand" title="Mostrar información"></i>
              </summary>
              <div class="poke5e-move-catalog-effect">
                <div class="poke5e-move-meta">
                  <span><strong>Activación:</strong> {{time}}</span>
                  <span><strong>Alcance:</strong> {{range}}</span>
                  <span><strong>Duración:</strong> {{duration}}</span>
                  {{#if attackBonus}}<span><strong>Ataque:</strong> {{attackBonus}}</span>{{/if}}
                  {{#if saveDc}}<span><strong>CD:</strong> {{saveDc}}</span>{{/if}}
                  <span><strong>Daño:</strong> {{damage}}</span>
                </div>
                <div class="poke5e-description">{{{description}}}</div>
              </div>
            </details>
          {{else}}<div class="poke5e-empty">No hay movimientos en esta categoría.</div>{{/each}}
        </div>
      </div>
    {{/if}}
    <div class="poke5e-move-list">
      {{#each moves}}
        <details class="poke5e-move type-border-{{type}}">
          <summary>
            <span class="poke5e-type type-{{type}}">{{type}}</span>
            <strong>{{name}}</strong>
            <span class="poke5e-move-rolls">
              {{#if attackBonus}}Ataque {{attackBonus}}{{/if}}
              {{#if saveDc}}CD {{saveDc}}{{/if}}
              · {{damage}}
            </span>
            {{#if hasPp}}<span class="poke5e-pp">PP {{pp.value}}/{{pp.max}}</span>{{/if}}
          </summary>
          <div class="poke5e-move-body">
            <div class="poke5e-learning-methods known-move">
              {{#each learningMethods}}<span>{{label}}</span>{{/each}}
              {{#if learningWarning}}<span class="warning"><i class="fa-solid fa-triangle-exclamation"></i> {{learningWarning}}</span>{{/if}}
            </div>
            <div class="poke5e-move-meta"><span>{{time}}</span><span>{{range}}</span></div>
            <div class="poke5e-description">{{{description}}}</div>
            <div class="poke5e-actions inline">
              {{#if ../canEdit}}{{#if hasPp}}<button type="button" data-action="restore-pp" data-move-entry-id="{{entryId}}" title="Restaurar PP"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}
              <button type="button" data-action="remove-move" data-move-entry-id="{{entryId}}" title="Olvidar movimiento"><i class="fa-solid fa-trash"></i></button>{{/if}}
              <button type="button" class="bright" data-action="roll-move" data-move-entry-id="{{entryId}}"><i class="fa-solid fa-dice-d20"></i> Usar movimiento</button>
            </div>
          </div>
        </details>
      {{else}}
        <div class="poke5e-empty">Este actor todavía no tiene movimientos Pokémon.</div>
      {{/each}}
    </div>
  </section>

  <section>
    <div class="poke5e-section-title"><h2>Habilidades</h2></div>
    {{#if canEdit}}<div class="poke5e-drop-hint"><i class="fa-solid fa-hand-pointer"></i> Arrastra habilidades desde su compendio para añadirlas.</div>{{/if}}
    <div class="poke5e-ability-grid">
      {{#each abilities}}
        <article class="poke5e-ability">
          <h3>{{name}}{{#if hidden}} <span>Oculta</span>{{/if}} {{#if ../canEdit}}<button type="button" data-action="remove-ability" data-ability-id="{{id}}" title="Eliminar habilidad"><i class="fa-solid fa-xmark"></i></button>{{/if}}</h3>
          <div>{{{description}}}</div>
        </article>
      {{/each}}
    </div>
  </section>
</article>
