<section class="poke5e poke5e-sheet-team-tab tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <header class="poke5e-sheet-team-header">
    <div class="poke5e-ball small" aria-hidden="true"></div>
    <div>
      <p class="eyebrow">{{localize "POKE5E.Team.TrainerSheet"}}</p>
      <h2>{{localize "POKE5E.Team.Title"}}</h2>
      <p>{{localize "POKE5E.Team.Summary" active=pokemon.teamCount limit=pokemon.maxTeamSize total=pokemon.allCount}}</p>
      {{#if pokemon.overControlSr}}
        <p class="warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "POKE5E.Team.ControlSrOver" max=pokemon.maxControlSr count=pokemon.overControlSr}}</p>
      {{else}}
        <p>{{localize "POKE5E.Team.ControlSr" max=pokemon.maxControlSr}}</p>
      {{/if}}
    </div>
    <div class="poke5e-sheet-team-actions">
      {{#if pokemon.canEdit}}
        <button type="button" class="bright" data-action="capturePokemon"><i class="fa-solid fa-circle-dot"></i> {{localize "POKE5E.Team.CaptureTarget"}}</button>
        <button type="button" class="bright" data-action="browsePokemon"><i class="fa-solid fa-plus"></i> {{localize "POKE5E.Team.AddPokemon"}}</button>
      {{/if}}
    </div>
  </header>

  {{#if pokemon.trainerProgression}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading">
        <i class="fa-solid fa-graduation-cap"></i>
        <div>
          <strong>{{localize "POKE5E.TrainerProgression.Title"}}</strong>
          <small>{{localize "POKE5E.TrainerProgression.LevelSummary" level=pokemon.trainerProgression.currentLevel xp=pokemon.trainerProgression.total}}</small>
        </div>
      </div>
      <div class="poke5e-trainer-progression-bar">
        <progress min="0" max="100" value="{{pokemon.trainerProgression.percent}}"></progress>
        {{#if pokemon.trainerProgression.maximumLevel}}
          <small>{{localize "POKE5E.TrainerProgression.MaximumLevel"}}</small>
        {{else if pokemon.trainerProgression.pendingLevels}}
          <small>{{localize "POKE5E.TrainerProgression.Ready" level=pokemon.trainerProgression.targetLevel}}</small>
        {{else}}
          <small>{{localize "POKE5E.Common.XPToLevel" xp=pokemon.trainerProgression.remaining level=pokemon.trainerProgression.nextLevel}}</small>
        {{/if}}
      </div>
      {{#if pokemon.canEdit}}
        <div class="poke5e-trainer-progression-actions">
          <button type="button" data-action="addTrainerExperience"><i class="fa-solid fa-plus"></i> {{localize "POKE5E.TrainerProgression.AddXP"}}</button>
          <button type="button" class="bright" data-action="advanceTrainerClass" {{#unless pokemon.trainerProgression.canAdvance}}disabled{{/unless}}><i class="fa-solid fa-arrow-up"></i> {{localize "POKE5E.TrainerProgression.Advance"}}</button>
        </div>
      {{/if}}
    </section>
  {{/if}}

  {{#if pokemon.specializationProgression}}
    <section class="poke5e-trainer-progression warning">
      <div class="poke5e-trainer-progression-heading">
        <i class="fa-solid fa-medal"></i>
        <div><strong>{{localize "POKE5E.TrainerClass.SpecializationPending"}}</strong><small>{{localize "POKE5E.TrainerClass.SpecializationsPending" count=pokemon.specializationProgression.pending}}</small></div>
      </div>
      {{#if pokemon.canEdit}}<button type="button" class="bright" data-action="chooseSpecialization" {{#unless pokemon.specializationProgression.available}}disabled{{/unless}}><i class="fa-solid fa-list-check"></i> {{localize "POKE5E.TrainerClass.ChooseSpecialization"}}</button>{{/if}}
    </section>
  {{/if}}

  {{#if pokemon.pokemonTracker}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading">
        <i class="fa-solid fa-binoculars"></i>
        <div><strong>{{localize "POKE5E.TrainerClass.Tracker"}}</strong><small>{{localize "POKE5E.TrainerClass.TrackerUses" remaining=pokemon.pokemonTracker.remaining max=pokemon.pokemonTracker.max}}{{#if pokemon.pokemonTracker.expert}} · {{localize "POKE5E.TrainerClass.TrackerExpert"}}{{/if}}</small></div>
      </div>
      {{#if pokemon.canEdit}}<button type="button" data-action="usePokemonTracker" {{#unless pokemon.pokemonTracker.remaining}}disabled{{/unless}}><i class="fa-solid fa-magnifying-glass-location"></i> {{localize "POKE5E.TrainerClass.Search"}}</button>{{/if}}
    </section>
  {{/if}}

  {{#if pokemon.masterTrainer}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading">
        <i class="fa-solid fa-crown"></i>
        <div><strong>{{localize "POKE5E.TrainerClass.MasterTrainer"}}</strong><small>{{localize "POKE5E.TrainerClass.MasterTrainerUses" remaining=pokemon.masterTrainer.remaining max=pokemon.masterTrainer.max}}</small></div>
      </div>
    </section>
  {{/if}}

  {{#if pokemon.hasPathResources}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading"><i class="fa-solid fa-road"></i><div><strong>{{localize "POKE5E.TrainerPaths.Resources"}}</strong><small>{{localize "POKE5E.TrainerPaths.ResourcesHint"}}</small></div></div>
      {{#each pokemon.pathResources}}
        <div class="poke5e-trainer-progression-actions">
          <strong>{{name}}: {{value}}/{{maximum}}</strong>
          {{#if ../pokemon.canEdit}}
            <button type="button" data-action="spendPathResource" data-item-id="{{itemId}}" title="{{localize "POKE5E.TrainerPaths.Spend"}}"><i class="fa-solid fa-minus"></i></button>
            <button type="button" data-action="restorePathResource" data-item-id="{{itemId}}" title="{{localize "POKE5E.TrainerPaths.Restore"}}"><i class="fa-solid fa-plus"></i></button>
          {{/if}}
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if pokemon.typeMasteryChoice}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading"><i class="fa-solid fa-shield-halved"></i><div><strong>Almacenar poder (Maestro de Tipo 9)</strong><small>Los Pokémon de tus especializaciones ganan resistencia al tipo elegido; una vulnerabilidad previa a ese tipo pasa a daño normal.</small></div></div>
      {{#if pokemon.canEdit}}
        <label><span>Tipo elegido</span><select data-action="selectTypeMastery">{{selectOptions pokemon.typeMasteryChoice.options selected=pokemon.typeMasteryChoice.selected}}</select></label>
      {{else}}
        <span>{{pokemon.typeMasteryChoice.selectedLabel}}</span>
      {{/if}}
    </section>
  {{/if}}

  {{#if pokemon.rangerCompanionChoice}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading"><i class="fa-solid fa-paw"></i><div><strong>Compañero (Guardabosques 9)</strong><small>Sumas tu modificador de Sabiduría a los ataques de tu compañero contra Pokémon salvajes. Con Poké Assist (Guardabosques 15), sus tipos también dan ventaja a movimientos y capturas.</small></div></div>
      {{#if pokemon.canEdit}}
        <label><span>Compañero</span><select data-action="selectRangerCompanion">{{selectOptions pokemon.rangerCompanionChoice.options selected=pokemon.rangerCompanionChoice.selected blank="—"}}</select></label>
      {{else}}
        <span>{{pokemon.rangerCompanionChoice.selectedLabel}}</span>
      {{/if}}
    </section>
  {{/if}}

  {{#if pokemon.aceTrainerAbilityChoice}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading"><i class="fa-solid fa-arrow-up-wide-short"></i><div><strong>Maestría táctica (Entrenador de Élite 9)</strong><small>+1 a la característica elegida para todos tus Pokémon, incluidos los que captures después.</small></div></div>
      {{#if pokemon.canEdit}}
        <label><span>Característica</span><select data-action="selectAceTrainerAbility">{{selectOptions pokemon.aceTrainerAbilityChoice.options selected=pokemon.aceTrainerAbilityChoice.selected blank="—"}}</select></label>
      {{/if}}
    </section>
  {{/if}}

  {{#if pokemon.guruSpiritResource}}
    <section class="poke5e-trainer-progression">
      <div class="poke5e-trainer-progression-heading"><i class="fa-solid fa-hand-sparkles"></i><div><strong>Espíritu (Gurú 15)</strong><small>Suma tu modificador de Sabiduría a los ataques o al daño de todo tu equipo desplegado hasta tu próximo turno ({{pokemon.guruSpiritResource.remaining}}/{{pokemon.guruSpiritResource.max}} usos).</small></div></div>
      {{#if pokemon.canEdit}}<button type="button" data-action="guruSpirit"><i class="fa-solid fa-hand-sparkles"></i> Usar Espíritu</button>{{/if}}
    </section>
  {{/if}}

  <section class="poke5e-currency-panel">
    <i class="fa-solid fa-coins"></i>
    <label><span>{{localize "POKE5E.Currency.Name"}}</span><input type="number" min="0" step="1" value="{{pokemon.pokedollars}}" data-poke5e-pokedollars {{#unless pokemon.canEdit}}disabled{{/unless}}></label>
    <strong>₽</strong>
  </section>

  <div class="poke5e-sheet-slots">
    {{#each pokemon.slots}}
      {{#if empty}}
        <button type="button" class="poke5e-sheet-slot empty" data-action="browsePokemon" {{#unless ../pokemon.canEdit}}disabled{{/unless}}>
          <span class="slot-number">{{position}}</span>
          <i class="fa-solid fa-plus"></i>
          <strong>{{localize "POKE5E.Team.FreeSlot"}}</strong>
          <small>{{localize "POKE5E.Team.AddFromPokedex"}}</small>
        </button>
      {{else}}
        <article class="poke5e-sheet-slot occupied" data-item-id="{{itemId}}">
          <button type="button" class="pokemon-portrait" data-action="openPokemon" title="{{localize "POKE5E.Team.OpenNamedSheet" name=name}}">
            <img src="{{img}}" alt="{{name}}">
          </button>
          <div class="pokemon-summary">
            <span class="slot-number">{{position}}</span>
            <button type="button" class="pokemon-name" data-action="openPokemon">{{name}}</button>
            {{#if instance.nickname}}<small>{{speciesName}}</small>{{/if}}
            <span>{{localize "POKE5E.Team.LevelAC" level=instance.level ac=instance.ac}}</span>
            <div class="pokemon-hp" title="{{localize "POKE5E.Team.HPTitle" hp=hpValue max=hpMax}}">
              <span style="width: {{hpPercent}}%"></span>
            </div>
            <small>PG {{hpValue}}/{{hpMax}}</small>
            <div class="pokemon-exp" title="{{localize "POKE5E.Team.XPTitle" xp=experience.total remaining=experience.remaining}}">
              <span style="width: {{experience.percent}}%"></span>
            </div>
            <small>PX {{experience.total}}/{{experience.ceiling}}</small>
          </div>
          {{#if ../pokemon.canEdit}}
            <div class="pokemon-controls">
              {{#if fainted}}
                <button type="button" class="bright" data-action="healFaintedPokemon" title="{{localize "POKE5E.Team.FullyHeal"}}"><i class="fa-solid fa-heart-pulse"></i></button>
                <button type="button" data-action="removeFaintedPokemon" title="{{localize "POKE5E.Team.RemoveDead"}}"><i class="fa-solid fa-skull"></i></button>
              {{else}}
                {{#if deployed}}
                  <button type="button" data-action="recallPokemon" title="{{localize "POKE5E.Team.Recall"}}"><i class="fa-solid fa-arrow-rotate-left"></i></button>
                {{else}}
                  <button type="button" data-action="deployPokemon" title="{{localize "POKE5E.Team.Deploy"}}"><i class="fa-solid fa-location-dot"></i></button>
                {{/if}}
                {{#if @root.pokemon.pokechefAvailable}}<button type="button" data-action="givePokechef" title="Pokéchef (Enfermero Pokémon): prepara y da una golosina que cura PG"><i class="fa-solid fa-cookie-bite"></i></button>{{/if}}
              {{/if}}
              <button type="button" data-action="togglePokemonTeam" title="{{localize "POKE5E.Team.SendReserve"}}"><i class="fa-solid fa-box-archive"></i></button>
            </div>
          {{/if}}
        </article>
      {{/if}}
    {{/each}}
  </div>

  <section class="poke5e-sheet-reserve">
    <div class="poke5e-section-title">
      <h3>{{localize "POKE5E.Team.Reserve"}}</h3>
      <span>{{localize "POKE5E.Common.PokemonCount" count=pokemon.reserve.length}}</span>
    </div>
    {{#if pokemon.reserve.length}}
      <div class="poke5e-sheet-reserve-grid">
        {{#each pokemon.reserve}}
          <article data-item-id="{{itemId}}">
            <button type="button" class="reserve-portrait" data-action="openPokemon"><img src="{{img}}" alt="{{name}}"></button>
            <button type="button" class="reserve-name" data-action="openPokemon"><strong>{{name}}</strong><small>{{speciesName}} · {{localize "POKE5E.Common.LevelValue" level=instance.level}}</small></button>
            <span>PG {{hpValue}}/{{hpMax}} · PX {{experience.total}}{{#if overflow}} · {{localize "POKE5E.Team.NoSlot"}}{{/if}}</span>
            {{#if ../pokemon.canEdit}}
              <div class="reserve-controls">
                {{#if fainted}}
                  <button type="button" class="bright" data-action="healFaintedPokemon" title="{{localize "POKE5E.Team.FullyHeal"}}"><i class="fa-solid fa-heart-pulse"></i></button>
                  <button type="button" data-action="removeFaintedPokemon" title="{{localize "POKE5E.Team.RemoveDead"}}"><i class="fa-solid fa-skull"></i></button>
                {{else}}
                  <button type="button" data-action="togglePokemonTeam" title="{{localize "POKE5E.Team.AddToTeam"}}"><i class="fa-solid fa-arrow-up"></i></button>
                {{/if}}
              </div>
            {{/if}}
          </article>
        {{/each}}
      </div>
    {{else}}
      <div class="poke5e-empty">{{localize "POKE5E.Team.NoReserve"}}</div>
    {{/if}}
  </section>
</section>
