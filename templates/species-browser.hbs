<div class="poke5e-species-browser-body">
  <header>
    <label><i class="fa-solid fa-magnifying-glass"></i><input type="search" value="{{filters.query}}" placeholder="{{localize "POKE5E.Common.SearchPokemonPlaceholder"}}" data-action="search"></label>
    <span>{{localize "POKE5E.Common.ResultCount" count=total}}</span>
  </header>
  <div class="poke5e-species-filters">
    <label><span>{{localize "POKE5E.Common.Type"}}</span><select data-filter="type">{{selectOptions typeOptions selected=filters.type blank=(localize "POKE5E.Common.All")}}</select></label>
    <fieldset>
      <legend>{{localize "POKE5E.Common.ChallengeRatingBilingual"}}</legend>
      <input type="number" min="0" step="0.125" value="{{filters.srMin}}" placeholder="Mín." aria-label="SR mínimo" data-filter="srMin">
      <span>—</span>
      <input type="number" min="0" step="0.125" value="{{filters.srMax}}" placeholder="Máx." aria-label="SR máximo" data-filter="srMax">
    </fieldset>
    <fieldset>
      <legend>{{localize "POKE5E.Common.MinimumLevelLabel"}}</legend>
      <input type="number" min="1" max="20" step="1" value="{{filters.levelMin}}" placeholder="Mín." aria-label="Nivel mínimo desde" data-filter="levelMin">
      <span>—</span>
      <input type="number" min="1" max="20" step="1" value="{{filters.levelMax}}" placeholder="Máx." aria-label="Nivel mínimo hasta" data-filter="levelMax">
    </fieldset>
    <label><span>{{localize "POKE5E.Common.Sort"}}</span><select data-filter="sort">{{selectOptions sortOptions selected=filters.sort}}</select></label>
    <button type="button" data-action="clear-filters" title="{{localize "POKE5E.Common.ResetFilters"}}"><i class="fa-solid fa-filter-circle-xmark"></i> {{localize "POKE5E.Common.Clear"}}</button>
  </div>
  {{#if missingPack}}
    <div class="poke5e-callout warning">{{localize "POKE5E.SpeciesBrowser.MissingPack"}}</div>
  {{else}}
    {{#if truncated}}<div class="poke5e-callout">{{localize "POKE5E.SpeciesBrowser.Truncated"}}</div>{{/if}}
    <div class="poke5e-species-grid">
      {{#each entries}}
        <article>
          <img src="{{img}}" alt="{{name}}">
          <div><small>#{{number}}</small><strong>{{name}}</strong><span>{{#each types}}{{this}}{{#unless @last}} / {{/unless}}{{/each}}</span><span class="species-rating">SR {{sr}} · {{localize "POKE5E.Common.MinimumLevel" level=minLevel}}</span></div>
          <button type="button" class="bright" data-action="add-species" data-document-id="{{id}}" data-source-id="{{sourceId}}"><i class="fa-solid fa-plus"></i></button>
        </article>
      {{else}}<div class="poke5e-empty">{{localize "POKE5E.Common.NoMatchingSpecies"}}</div>{{/each}}
    </div>
  {{/if}}
</div>
